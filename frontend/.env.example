# Copy this file to .env.local and adjust as needed.
# .env.local is gitignored — safe for machine-specific values.

# Base path for API calls. Left as /api so the Vite dev proxy (see vite.config.ts)
# forwards requests to the backend. In production this can point at a full URL,
# e.g. https://api.yourdomain.com
VITE_API_URL=/api

# When true, the UI uses bundled demo data (src/data/mockData.ts) instead of
# calling the backend. Useful for building/demoing the frontend standalone
# before the backend is ready. Set to false once the backend is wired up.
VITE_USE_MOCK_DATA=true
